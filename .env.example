# Copy to .env and fill in. Everything except ADMIN_PASSWORD / SESSION_SECRET is optional.

PORT=3000

# Public address once deployed, e.g. https://tanvi.design (no trailing slash).
# Used for canonical links, share previews and the sitemap.
SITE_URL=

# Where the SQLite file lives (created automatically)
DATABASE_PATH=./data/portfolio.db

# Admin panel at /admin
ADMIN_PASSWORD=change-me-to-something-long
# Random string used to sign admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to 1 when running behind a reverse proxy (Render, Railway, Nginx...) so
# rate limiting sees the real visitor IP and cookies are marked Secure.
TRUST_PROXY=0

# Email notifications for new contact messages. Leave SMTP_HOST empty to skip
# email; messages are still saved and visible in /admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Portfolio <no-reply@tanvi.design>"
MAIL_TO=hello@tanvi.design
